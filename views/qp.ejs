<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/stylesheets/tailwind.css" />
</head>
<%
  var btn        = 'border-0 rounded-md px-3.5 py-2.25 text-[.85rem] font-semibold cursor-pointer transition hover:brightness-110';
  var btnPrimary = btn + ' bg-[#2e7d32] text-white';
  var btnGhost   = btn + ' bg-white/15 text-white';
  var btnTool    = 'border border-[#c7d0dc] bg-white rounded-md px-2.5 py-1.5 text-[.78rem] font-semibold text-[#24476f] cursor-pointer hover:bg-[#f1f4f8] disabled:opacity-40 disabled:cursor-not-allowed';
  var inp        = 'px-2.5 py-2 border border-[#c7d0dc] rounded-md text-[.9rem] bg-white focus:outline-2 focus:outline-[#2e7d32] focus:border-[#2e7d32]';
  var cardCls    = 'bg-white rounded-[10px] shadow-[0_1px_4px_rgba(0,0,0,0.08)]';
%>
<body class="m-0 bg-[#eef1f6] text-[#1f2733] pb-16">
  <header class="flex justify-between items-center gap-4 flex-wrap bg-[#1f3a5f] text-white px-5.5 py-3.5">
    <div>
      <h1 class="text-[1.15rem] font-semibold m-0">Question Paper Allotment</h1>
      <div class="text-[.8rem] opacity-90 mt-0.75">
        Session: <strong><%= session || 'not set' %></strong>
        &nbsp;|&nbsp; Campus: <strong><%= campus %></strong>
        <% if (lastSync) { %>&nbsp;|&nbsp; Last sync: <span class="opacity-70"><%= new Date(lastSync).toLocaleString() %></span><% } %>
      </div>
    </div>
    <div class="flex gap-2.5">
      <a href="/" class="<%= btnGhost %> no-underline">Packet Entry</a>
      <a href="/qp/progress" class="<%= btnGhost %> no-underline">Progress</a>
      <a href="/qp/final?date=<%= date %>" class="<%= btnGhost %> no-underline">Finalised</a>
      <form method="post" action="/qp/sync" class="m-0"><button class="<%= btnPrimary %>" type="submit">Sync Master Data</button></form>
    </div>
  </header>

  <% if (flash) { var fc = flashType === 'success' ? 'bg-[#e4f6e6] text-[#1e6b26]' : flashType === 'error' ? 'bg-[#fbe6e6] text-[#9a2626]' : 'bg-[#e7f0fb] text-[#24476f]'; %>
    <div class="mx-5.5 mt-3.5 px-3.5 py-2.5 rounded-md text-[.88rem] <%= fc %>"><%= flash %></div>
  <% } %>

  <% if (!dates.length) { %>
    <div class="mx-5.5 mt-3.5 px-3.5 py-2.5 rounded-md text-[.88rem] bg-[#e7f0fb] text-[#24476f]">
      No timetable cached yet. Click <strong>Sync Master Data</strong> to load exam dates, subjects, required counts and room history from SQL Server.
    </div>
  <% } %>

  <!-- Context bar: date + subject + required figures -->
  <div class="sticky top-0 z-20 bg-white border-b border-[#dde3ec] px-5.5 py-2.5 flex items-center gap-4 flex-wrap shadow-[0_1px_3px_rgba(0,0,0,0.05)]">
    <label class="text-[.78rem] font-semibold text-[#3a4658]">Date of exam</label>
    <select id="dateSel" class="<%= inp %>">
      <% dates.forEach(function (d) { %>
        <% var lbl = d.planned > 0 ? d.finalised + '/' + d.planned + ' done' : 'no count'; %>
        <option value="<%= d.doe %>" <%= d.doe === date ? 'selected' : '' %>><%= d.doe %> &middot; <%= lbl %></option>
      <% }); %>
    </select>

    <div id="ctxSubject" class="flex items-center gap-2 min-w-0 flex-wrap">
      <span class="text-[1.05rem] font-bold text-[#1f3a5f]" id="ctxCode">—</span>
      <span class="chip chip-dept text-[.8rem]">Dept <b id="ctxDept">—</b></span>
      <span class="chip chip-mute text-[.8rem]">Sem <b id="ctxSem">—</b></span>
      <span class="text-[.8rem] text-slate-500" id="ctxMeta">select a subject</span>
    </div>

    <div class="ml-auto flex items-center gap-2 text-[.8rem]">
      <span class="chip chip-mute">Reg <b id="ctxReg">—</b></span>
      <span class="chip chip-mute">Arr <b id="ctxArr">—</b></span>
      <span class="chip chip-req">Required <b id="ctxReq">—</b></span>
      <span id="ctxLock" class="chip chip-lock" hidden>finalised</span>
    </div>
  </div>

  <main class="grid grid-cols-[290px_1fr] max-[900px]:grid-cols-1 gap-4.5 px-5.5 py-4.5 items-start">
    <!-- Subject rail -->
    <section class="<%= cardCls %> px-3.5 py-3.5 max-h-[calc(100vh-170px)] overflow-y-auto sticky top-15">
      <h2 class="mt-0 mb-2.5 text-[.82rem] font-semibold text-[#1f3a5f] uppercase tracking-wide flex justify-between items-baseline">
        Subjects
        <span class="text-[.7rem] font-normal normal-case text-slate-500" id="railSummary"></span>
      </h2>
      <ul id="rail" class="list-none m-0 p-0"></ul>

      <div id="unplannedWrap" hidden class="mt-3 border-t border-[#eef1f6] pt-2.5">
        <button id="unplannedToggle" type="button" class="w-full text-left text-[.75rem] text-slate-500 bg-transparent border-0 cursor-pointer p-0 hover:text-[#24476f]"></button>
        <ul id="unplanned" class="list-none m-0 p-0 mt-1.5" hidden></ul>
      </div>
    </section>

    <!-- Room grid -->
    <section class="<%= cardCls %> px-5 py-4">
      <div class="flex items-center gap-2 flex-wrap mb-3">
        <h2 class="mt-0 mb-0 mr-auto text-base font-semibold text-[#1f3a5f]">Room-wise QP entry</h2>
        <select id="copySrc" class="<%= btnTool %> py-1.75" disabled><option value="">Copy rooms from…</option></select>
        <label class="flex items-center gap-1.5 text-[.78rem] text-[#3a4658] cursor-pointer select-none"
               title="Bring the QP counts across too, instead of leaving the cells blank">
          <input id="copyQty" type="checkbox" class="accent-[#2e7d32] cursor-pointer" /> with counts
        </label>
        <button id="loadAllBtn" type="button" class="<%= btnTool %>" disabled title="Load every room seen before">All rooms</button>
        <button id="fillMaxBtn" type="button" class="<%= btnTool %>" disabled title="Fill blank QP cells with each room's Max (F4)">Fill blanks with Max <span class="opacity-60">F4</span></button>
        <button id="clearBtn" type="button" class="<%= btnTool %> text-[#9a2626]" disabled title="Delete every room row of this subject">Clear</button>
        <button id="unlockBtn" type="button" class="<%= btnTool %>" hidden>Unlock</button>
      </div>

      <div id="gridWrap" class="overflow-x-auto">
        <table id="qpTable" class="qp-table">
          <thead>
            <tr>
              <th class="w-8">#</th>
              <th>Room</th>
              <th class="w-20 text-right">Max</th>
              <th class="w-24 text-right">QP</th>
              <th class="w-24 text-right">Running</th>
              <th class="w-10"></th>
            </tr>
          </thead>
          <tbody id="qpBody">
            <tr><td colspan="6" class="empty">Pick a subject from the left to start entering rooms.</td></tr>
          </tbody>
          <tfoot id="qpFoot" hidden>
            <tr class="newrow">
              <td class="text-slate-400">+</td>
              <td><input id="newRoom" type="text" list="roomList" placeholder="room no." autocomplete="off" class="qp-room" /></td>
              <td class="text-right text-slate-400" id="newMax"></td>
              <td><input id="newQty" type="number" min="0" placeholder="QP" class="qp-qty" /></td>
              <td colspan="2" class="text-[.72rem] text-slate-400">Enter to save</td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p id="qpMsg" class="entry-msg"></p>

      <div id="problems" class="mt-2" hidden></div>
    </section>
  </main>

  <!-- Sticky totals / finalise bar -->
  <div class="fixed inset-x-0 bottom-0 z-30 bg-white border-t border-[#dde3ec] px-5.5 py-2.5 flex items-center gap-5 flex-wrap shadow-[0_-1px_6px_rgba(0,0,0,0.07)]">
    <span class="text-[.8rem] text-slate-500">Rooms <b class="text-[#1f2733]" id="fRooms">0</b></span>
    <span class="text-[.8rem] text-slate-500">Allotted <b class="text-[#1f2733]" id="fAllot">0</b></span>
    <span class="text-[.8rem] text-slate-500">Required <b class="text-[#1f2733]" id="fReq">—</b></span>
    <span id="fBal" class="chip chip-mute text-[.82rem]">Balance —</span>
    <span id="fBlanks" class="chip chip-warn text-[.78rem]" hidden></span>
    <span class="ml-auto text-[.72rem] text-slate-400 max-[700px]:hidden">Enter saves &amp; moves down &middot; F4 fills blanks &middot; Ctrl+Enter finalises</span>
    <button id="finaliseBtn" class="<%= btnPrimary %> disabled:bg-[#93b795] disabled:cursor-not-allowed disabled:hover:brightness-100" type="button" disabled>Finalise subject</button>
  </div>

  <datalist id="roomList">
    <% rooms.forEach(function (r) { %><option value="<%= r.roomno %>"></option><% }); %>
  </datalist>

  <script id="qpBootstrap" type="application/json"><%- JSON.stringify({ date: date, subjects: subjects, summary: summary }) %></script>
  <script src="/javascripts/qp.js"></script>
</body>
</html>
