<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/stylesheets/tailwind.css" />
  <style>
    /* ---- Printed sheet: 17 x 11 in landscape, one room per exam date ---- */
    @page { size: 17in 11in; margin: 0; }

    .sheet {
      position: relative; width: 17in; height: 11in; box-sizing: border-box;
      margin: 0 auto 24px; padding: .75in 1.4in .6in; background: #fff; color: #000;
      overflow: hidden; box-shadow: 0 2px 10px rgba(0, 0, 0, .18);
      font-family: 'Trebuchet MS', Verdana, sans-serif;
    }
    .sheet .banner {
      border-top: 3px double #000; border-bottom: 3px double #000; padding: 8px 0;
      text-align: center; font: 700 17pt 'Bookman Old Style', Georgia, serif;
      letter-spacing: 3px; word-spacing: 4px;
    }
    .sheet .banner i { font-style: normal; padding: 0 14px; color: #666; }
    .sheet .room {
      margin-top: .45in; text-align: center;
      font: 400 44pt 'Arial Black', Arial, sans-serif;
      text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 8px;
    }
    .sheet .doe {
      margin-top: .2in; text-align: center; color: #c00000;
      font: 700 26pt 'Bookman Old Style', Georgia, serif;
      text-decoration: underline; text-underline-offset: 5px;
    }

    .sheet .grid {
      margin-top: .4in; border: 2px solid #000; border-radius: 14px; padding: 6px 18px 4px;
    }
    .sheet .grid table { width: 100%; border-collapse: collapse; font-size: 16pt; }
    .sheet .grid th, .sheet .grid td {
      padding: 9px 10px; border: 0; white-space: nowrap; text-align: left; vertical-align: top;
    }
    .sheet .grid th {
      font: 700 12.5pt 'Trebuchet MS', Verdana, sans-serif; color: #7a1f1f;
      text-transform: uppercase; letter-spacing: .5px; border-bottom: 2px solid #000;
    }
    .sheet .grid tbody td { border-bottom: 1.5px dashed #000; }
    .sheet .grid tbody tr:last-child td { border-bottom: 0; }
    .sheet .grid .num { text-align: right; }
    .sheet .grid .ctr { text-align: center; }
    /* No. of Scripts: pulled in from the right edge, value sits under "OF". */
    .sheet .grid th.scr { text-align: left; padding-right: .9in; }
    .sheet .grid tbody td.scr { text-align: left; padding-left: .42in; }
    .sheet .grid .code { font-weight: 700; }
    .sheet .grid tfoot td {
      border-top: 2px solid #000; font-weight: 700; padding-top: 8px; padding-bottom: 6px;
    }
    .sheet .note { margin-top: 12px; font: italic 700 12pt Georgia, serif; }

    /* Rooms with many subjects: tighter rows so the page still holds them all. */
    .sheet.dense .grid table { font-size: 12.5pt; }
    .sheet.dense .grid th, .sheet.dense .grid td { padding: 5px 10px; }
    .sheet.dense .room { margin-top: .25in; font-size: 36pt; }
    .sheet.dense .grid { margin-top: .25in; }
    .sheet.denser .grid table { font-size: 10.5pt; }
    .sheet.denser .grid th, .sheet.denser .grid td { padding: 3px 10px; }
    .sheet.denser .banner { padding: 4px 0; font-size: 14pt; }
    .sheet.denser .doe { margin-top: .1in; font-size: 22pt; }

    /* Preview on screen at reduced size so a 17in sheet fits the window. */
    @media screen { .sheet { zoom: .6; } }

    @media print {
      html, body, main { margin: 0 !important; padding: 0 !important; background: #fff !important; }
      .no-print { display: none !important; }
      .sheet { margin: 0; box-shadow: none; break-after: page; }
      .sheet:last-child { break-after: auto; }
    }
  </style>
</head>
<%
  var btnGhost = 'border-0 rounded-md px-3.5 py-2.25 text-[.85rem] font-semibold cursor-pointer bg-white/15 text-white no-underline';
  var BANNER = ['B.A.', 'B.Sc.', 'B.M.B.T.', 'M.A.', 'M.Sc', 'MMM', 'P.G. Diploma'];
  var pages = sheets.length;
  var subjects = sheets.reduce(function (n, p) { return n + p.rows.length; }, 0);
  var drafts = [];
  sheets.forEach(function (p) {
    p.rows.forEach(function (r) {
      if (r.status === 'draft' && drafts.indexOf(r.subcode) === -1) drafts.push(r.subcode);
    });
  });
%>
<body class="m-0 bg-[#eef1f6] text-[#1f2733]">
  <header class="no-print flex justify-between items-center gap-4 flex-wrap bg-[#1f3a5f] text-white px-5.5 py-3.5">
    <div>
      <h1 class="text-[1.15rem] font-semibold m-0"><%= title %></h1>
      <div class="text-[.8rem] opacity-90 mt-0.75">
        Session: <strong><%= session %></strong> &nbsp;|&nbsp; Page: <strong>17 &times; 11 in landscape</strong>
        &nbsp;|&nbsp; One sheet per room per exam date
      </div>
    </div>
    <div class="flex gap-2.5">
      <a href="/qp<%= f.doe ? '?date=' + f.doe : '' %>" class="<%= btnGhost %>">&larr; Back to entry</a>
      <a href="/qp/progress" class="<%= btnGhost %>">Progress</a>
      <%- include('partials/reportsmenu', { date: f.doe, current: '/qp/artsreport' }) %>
    </div>
  </header>

  <main class="px-5.5 py-4.5">
    <%- include('partials/reportfilter', {
      action: '/qp/artsreport', filters: filters, f: f, any: any, pages: pages,
      summary: '<strong>' + pages + '</strong> room sheet(s), <strong>' + subjects + '</strong> subject line(s)'
    }) %>

    <% if (drafts.length) { %>
      <div class="no-print bg-[#fff8e8] border border-[#f0d9a4] text-[#8a5a00] rounded-[10px] px-4.5 py-3 mb-4.5 text-[.88rem]">
        <strong><%= drafts.length %></strong> subject(s) here are not finalised yet, so their counts may still change:
        <%= drafts.join(', ') %>
      </div>
    <% } %>
    <% if (any && !pages) { %>
      <div class="no-print text-center text-slate-500 py-10">No rooms entered for this filter.</div>
    <% } %>

    <% sheets.forEach(function (p) { %>
      <section class="sheet<%= p.rows.length > 12 ? ' dense' : '' %><%= p.rows.length > 17 ? ' denser' : '' %>">
        <div class="banner"><%- BANNER.map(function (d) { return d.replace(/&/g, '&amp;').replace(/</g, '&lt;'); }).join('<i>|</i>') %></div>
        <div class="room">ROOM No : - <%= p.roomno %></div>
        <div class="doe">Date Of Exam - <%= p.dateText %></div>

        <div class="grid">
          <table>
            <thead>
              <tr>
                <th>Dept</th><th>Subject</th><th class="ctr">Sem</th><th class="num">No. of QPs</th>
                <th>Time</th><th>Duration</th><th class="scr">No. of Scripts*</th>
              </tr>
            </thead>
            <tbody>
              <% p.rows.forEach(function (r) { %>
                <tr>
                  <td><%= r.dept %></td>
                  <td><span class="code"><%= r.subcode %></span></td>
                  <td class="ctr"><%= r.sem %></td>
                  <td class="num code"><%= r.qty %></td>
                  <td><%= r.timeText %></td>
                  <td><%= r.duration %></td>
                  <td class="scr"><%= r.scripts %></td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3" class="num">Total QPs</td>
                <td class="num"><%= p.total %></td>
                <td colspan="3"></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <div class="note">* Number of Answer Scripts per candidate.</div>
      </section>
    <% }) %>
  </main>
</body>
</html>
